// Settings shared by every target (app AND both test bundles). Deliberately
// does NOT include Product.xcconfig — PRODUCT_NAME/PRODUCT_BUNDLE_IDENTIFIER
// must stay per-target (App.xcconfig) or every target ends up with the same
// product name and Xcode's build system collides on the output paths.
DEVELOPMENT_TEAM = 6X5YH93QNM
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.10
// iPhone only (DECISIONS 0009).
TARGETED_DEVICE_FAMILY = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
CODE_SIGN_STYLE = Automatic
// Simulator builds/tests need no signing identity; a device archive needs
// the team above and an explicit App ID (docs/APP-STORE.md has the owner
// steps). Never StoreKit, never a third-party SDK (DECISIONS 0002/0003).
ENABLE_HARDENED_RUNTIME = YES
