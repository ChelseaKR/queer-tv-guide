{% extends "base.html.j2" %}
{% block head_extra %}{% if robots %}
<meta name="robots" content="{{ robots }}">{% endif %}{% endblock %}
{% block content %}
<h1>Do any queer characters die in {{ show.title }}?</h1>
<p class="opening">{{ opening }}</p>
<p>Does she die in {{ show.title }}? {{ site_name }} answers from LezWatch.TV's records, so you can check for the bury-your-gays trope before you start the show. LezWatch.TV covers queer women, non-binary and trans characters, so this page does not list cisgender gay and bisexual men. Nothing is revealed until you open the answer below.</p>
<p class="spoiler-warning"><strong>Spoiler warning:</strong> the answer below says which listed characters LezWatch.TV records as dying, if any.</p>
<details class="answer">
<summary>Show the answer (spoilers)</summary>
<div class="answer-body" data-nosnippet>
<p data-answer="headline"><strong>{{ answer.headline }}</strong></p>
<ul>
{%- for c in cast %}
<li data-status="{{ 'dies' if c.dies else 'unknown' }}"><span class="who">{{ c.name }}</span>: <span class="status">{{ c.status }}</span></li>
{%- endfor %}
</ul>
{%- for note in answer.notes %}
<p class="small">{{ note }}</p>
{%- endfor %}
<p class="small">LezWatch.TV records deaths, not survival. Unknown means no death is on record, which is not the same as the character living.</p>
</div>
</details>
{% if app_store_url %}
{{ app_store_block|safe }}
{% else %}
<p class="small">{{ site_name }} is also an iPhone app built from the same records. It is not on the App Store yet.</p>
{% endif %}
<h2>About {{ show.title }}</h2>
<dl class="facts">
{%- for label, value in facts %}
<dt>{{ label }}</dt>
<dd>{{ value }}</dd>
{%- endfor %}
</dl>
<p class="small">Facts marked “per TVmaze”, and the network when LezWatch.TV lists none, come from TVmaze, licensed <a href="{{ licence.snapshot.url }}">CC BY-SA 4.0</a>: {% if tvmaze_url %}<a href="{{ tvmaze_url }}">this show on TVmaze</a>{% else %}<a href="https://www.tvmaze.com/">TVmaze</a>{% endif %}.</p>
<h2>Queer women, non-binary and trans characters in {{ show.title }}</h2>
<p>LezWatch.TV lists {{ cast|length }} queer {{ 'character' if cast|length == 1 else 'characters' }} in {{ show.title }}, regulars first. Each name links to the character's LezWatch.TV page, and actors are named as LezWatch.TV lists them.</p>
<ul class="cast">
{%- for c, actor in listed %}
<li id="{{ c.anchor }}"><strong><a href="{{ c.source_url }}">{{ c.name }}</a></strong>{% if actor %}, {{ actor }}{% endif %}. Role: {{ c.role }}. Gender: {{ c.gender }}. Sexuality: {{ c.sexuality }}.</li>
{%- endfor %}
</ul>
<p><a href="{{ show.source_url }}">View {{ show.title }} on LezWatch.TV</a></p>
{%- if similar %}
<h2>Shows like {{ show.title }}</h2>
<ul class="similar">
{%- for o in similar %}
<li><a href="{{ o.url }}">{{ o.title }}</a></li>
{%- endfor %}
</ul>
<p class="small">Picked from LezWatch.TV's similar shows, then the shows here that share the most genres.</p>
{%- endif %}
<h2>More shows</h2>
<ul class="more">
{%- for o in others %}
<li><a href="{{ o.url }}">{{ o.title }}</a></li>
{%- endfor %}
<li><a href="{{ base_url }}/shows/">All {{ total }} {{ 'show' if total == 1 else 'shows' }}</a></li>
</ul>
{% endblock %}
