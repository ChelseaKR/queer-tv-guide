{% extends "base.html.j2" %}
{% block content %}
<h1>Does she die in {{ show.title }}?</h1>
<p>{{ site_name }} answers this from the records of LezWatch.TV, a volunteer-run database of queer characters on TV. Nothing is revealed until you open the answer below.</p>
<p class="spoiler-warning"><strong>Spoiler warning:</strong> the answer below says which listed characters LezWatch.TV records as dying, if any.</p>
<details class="answer">
<summary>Show the answer (spoilers)</summary>
<div class="answer-body">
<p data-answer="headline"><strong>{{ answer.headline }}</strong></p>
<ul>
{%- for c in cast %}
<li data-status="{{ 'dies' if c.dies else 'unknown' }}"><span class="who">{{ c.name }}</span>: <span class="status">{{ c.status }}</span></li>
{%- endfor %}
</ul>
{%- for note in answer.notes %}
<p class="small">{{ note }}</p>
{%- endfor %}
<p class="small">LezWatch.TV records deaths, not survival. Unknown means no death is on record, which is not the same as the character living.</p>
</div>
</details>
{% if app_store_url %}
<p class="cta">Get the app: <a href="{{ app_store_url }}">{{ app_store_copy }}</a></p>
{% endif %}
<h2>About {{ show.title }}</h2>
<dl class="facts">
{%- for label, value in facts %}
<dt>{{ label }}</dt>
<dd>{{ value }}</dd>
{%- endfor %}
</dl>
<p class="small">Run status, and the network when LezWatch.TV lists none, come from TVmaze, licensed <a href="{{ licence.snapshot.url }}">CC BY-SA 4.0</a>: {% if tvmaze_url %}<a href="{{ tvmaze_url }}">this show on TVmaze</a>{% else %}<a href="https://www.tvmaze.com/">TVmaze</a>{% endif %}.</p>
<h2>Queer characters LezWatch.TV lists</h2>
<ul class="cast">
{%- for c in cast %}
<li><a href="{{ c.source_url }}">{{ c.name }}</a>. Role: {{ c.role }}. Gender: {{ c.gender }}. Sexuality: {{ c.sexuality }}.</li>
{%- endfor %}
</ul>
<p><a href="{{ show.source_url }}">View {{ show.title }} on LezWatch.TV</a></p>
<h2>More shows</h2>
<ul class="more">
{%- for o in others %}
<li><a href="{{ o.url }}">{{ o.title }}</a></li>
{%- endfor %}
<li><a href="{{ base_url }}/shows/">All {{ total }} {{ 'show' if total == 1 else 'shows' }}</a></li>
</ul>
{% endblock %}
