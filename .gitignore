# pipeline
pipeline/.venv/
pipeline/.cache/
pipeline/out/
pipeline/site/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# never commit a mirror or a built snapshot; they are release assets
*.tar.gz
snapshot.v1.json
snapshot.v1.json.sha256
!schema/snapshot.v1.json
# os / editors
.DS_Store
# ios (owned by the app lane; listed so a stray build never lands here)
# ios/QueerTVGuide/Resources/snapshot.v1.json is ignored by the
# snapshot.v1.json rule above on purpose: it is a byte-for-byte copy of the
# published snapshot, fetched and checksum-verified by
# `make -C ios bundle-snapshot` (the build and test targets run it when the
# file is missing), never committed.
ios/**/build/
ios/**/DerivedData/
ios/**/*.xcuserstate
# android: build output and machine-local SDK paths. The bundled
# android/app/src/main/assets/snapshot.v1.json is ignored by the
# snapshot.v1.json rule above, as on iOS: `make -C android bundle-snapshot`
# fetches and checksum-verifies it.
android/.gradle/
android/.kotlin/
android/build/
android/*/build/
android/local.properties
android/.idea/
android/captures/
android/release/
*.keystore
*.jks
android/signing.properties
