<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Favorites, the first-run flag and the reminder
     switch move with a device-to-device transfer (a new phone set up from
     the old one, cable or Wi-Fi Direct). Nothing goes to cloud backup: no
     copy of what someone follows leaves their devices (DECISIONS 0018). The
     snapshot is not moved either way; the new device fetches its own. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="queer_frame.xml" />
    </device-transfer>
</data-extraction-rules>
