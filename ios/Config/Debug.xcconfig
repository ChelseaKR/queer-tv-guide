#include "Shared.xcconfig"
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
ONLY_ACTIVE_ARCH = YES
CODE_SIGNING_ALLOWED = NO

// Simulator builds are signed ad hoc ("Sign to Run Locally": no identity,
// profile or account), so the App Group entitlement the Up Next widget reads
// through is in force in the simulator too. Without it the app has no shared
// container there and the widget can only say "open the app". Debug device
// builds stay unsigned, as before.
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = YES
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
CODE_SIGN_STYLE[sdk=iphonesimulator*] = Manual
DEVELOPMENT_TEAM[sdk=iphonesimulator*] =
